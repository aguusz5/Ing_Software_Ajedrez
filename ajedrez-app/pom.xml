<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ar.edu.uade</groupId>
        <artifactId>ajedrez</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ajedrez-app</artifactId>

    <dependencies>
        <dependency>
            <groupId>ar.edu.uade</groupId>
            <artifactId>ajedrez-nucleo</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ar.edu.uade</groupId>
            <artifactId>ajedrez-consola</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ar.edu.uade</groupId>
            <artifactId>ajedrez-gui-swing</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <!-- Arma ajedrez-app/target/ajedrez.jar con todos los módulos adentro,
         para correrlo con java -jar (ver README). -->
    <build>
        <finalName>ajedrez</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>app.Principal</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
