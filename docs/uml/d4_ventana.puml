@startuml d4_ventana
!include common.iuml
top to bottom direction
package "ajedrez-gui-swing (adaptador)" #E8F1FA {
  class VentanaSwing {
    +VentanaSwing(juego : JuegoDeAjedrez, temas : List<Tema>, dificultades : List<Dificultad>)
    +mostrar()
  }
  class PanelDelMenu <<pantalla>> {
    ~usarTema(t : Tema)
    ~permitirVolverALaPartida()
    ~conPotenciadores() : boolean
  }
  class PanelDeLaPartida <<pantalla>> {
    ~usarTema(t : Tema)
    ~empezarUnoContraUno(conPotenciadores : boolean)
    ~empezarContraLaComputadora(rival : ContraLaComputadora, conPotenciadores : boolean)
  }
  class Dificultad <<record>> {
    +nombre : String
    +descripcion : String
    +siElegisBlancas : ContraLaComputadora
    +siElegisNegras : ContraLaComputadora
    +paraJugarCon(colorDelJugador : modelo.Color) : ContraLaComputadora
  }
  class PanelDelTablero {
    ~setInvertido(invertido : boolean)
    ~usarColores(coordenadas : Color, marco : Color)
    ~mostrar(p : Posicion, pieza : Optional<DibujoDePieza>, fondo : Color, borde : Border)
    ~{static} coordenada(p : Posicion) : String
  }
  interface Tema <<Strategy>> {
    +nombre() : String
    +epigrafe() : String
    +paleta() : Paleta
    +bando(c : modelo.Color) : String
    +nombreDe(tipo : String, c : modelo.Color) : String
    +dibujoDe(p : Pieza) : DibujoDePieza
    +dibujoDe(p : Potenciador) : DibujoDePieza
    +pintarFondo(g : Graphics2D, ancho : int, alto : int)
  }
  class TemaClasico {
    +TemaClasico(glifos : GlifosDePieza)
  }
  class TemaStarWars {
    +TemaStarWars(glifos : GlifosDePieza, era : Era, imagenDeFondo : Optional<BufferedImage>)
  }
  class Era <<record>> {
    +nombre, epigrafe : String
    +bandoDeLasBlancas, bandoDeLasNegras : String
    +brilloDeLasBlancas, brilloDeLasNegras : Color
    +personajes : PersonajesDeStarWars
    +{static} rebelionContraImperio() : Era
    +{static} republicaContraSeparatistas() : Era
  }
  class Paleta <<record>> {
    +casillaClara, casillaOscura : Color
    +texto, titulo, epigrafe, marco : Color
    +fondoDelMenu : Color
  }
  interface DibujoDePieza {
    +nombre() : String
    +dibujar(g : Graphics, ancho : int, alto : int)
  }
  class DibujoDeGlifo <<record>> {
    +nombre : String
    +glifo : String
    +relleno, trazo : Color
  }
  class DibujoDePotenciador <<record>> {
    +nombre : String
    +brillo : Color
  }
  class DibujoPotenciado <<record>> <<Decorator>> {
    +pieza : DibujoDePieza
    +potenciador : DibujoDePieza
  }
  class DibujoDePersonaje <<record>> {
    +nombre : String
    +brillo : Color
  }
  class GlifosDePieza {
    +glifoDe(p : Pieza) : String
    +glifoDe(p : Potenciador) : String
  }
  class PersonajesDeStarWars {
    +{static} rebelionContraImperio() : PersonajesDeStarWars
    +{static} republicaContraSeparatistas() : PersonajesDeStarWars
    ~personajeDe(tipo : String, bando : modelo.Color) : Optional<Personaje>
  }
  class PersonajesDeLaGuerraDeLosClones <<dibujos>> {
    ~{static} anakin() / obiWan() / ahsoka() / atte() / soldadoClon()
    ~{static} dooku() / grievous() / ventress() / droideka() / superDroide() / droideDeCombate()
  }
  class Figuras <<ayudas de dibujo>> {
    ~{static} elipse() / rect() / poligono() / linea() / arco() / con() / dentro() / ambos() / desde()
  }
  class Personaje {
    ~{static} LADO : double
    ~Personaje(nombre : String, capas : List<Capa>)
    ~nombre() : String
    ~dibujar(g : Graphics2D, brillo : Color)
  }
  class "Personaje.Capa" as Capa <<record>> {
    +forma : Shape
    +pintura : Paint
  }
}
package "ajedrez-nucleo (lo que usa la ventana)" #EAF6EA {
  interface JuegoDeAjedrez <<puerto de entrada>>
  class ContraLaComputadora
}
VentanaSwing *-- PanelDelMenu
VentanaSwing *-- PanelDeLaPartida
PanelDelMenu --> "*" Dificultad : las ofrece
PanelDelMenu --> "*" Tema : los ofrece
PanelDeLaPartida --> Tema : el elegido en el menú
PanelDeLaPartida *-- PanelDelTablero
PanelDeLaPartida --> JuegoDeAjedrez
PanelDeLaPartida --> "0..1" ContraLaComputadora : la del modo elegido
Dificultad --> "2" ContraLaComputadora : una por color
PanelDelTablero ..> DibujoDePieza
Tema <|.. TemaClasico
Tema <|.. TemaStarWars
Tema ..> Paleta
Tema ..> DibujoDePieza : crea
DibujoDePieza <|.. DibujoDeGlifo
DibujoDePieza <|.. DibujoDePersonaje
DibujoDePieza <|.. DibujoDePotenciador
DibujoDePieza <|.. DibujoPotenciado
DibujoDePersonaje -left-> DibujoDeGlifo : insignia
DibujoDePotenciador --> DibujoDeGlifo : insignia
DibujoPotenciado --> "2" DibujoDePieza : pieza y potenciador
DibujoDePersonaje --> Personaje
TemaClasico --> GlifosDePieza
TemaStarWars --> GlifosDePieza
TemaStarWars --> Era
Era --> PersonajesDeStarWars
PersonajesDeStarWars --> "12" Personaje : 6 por bando
PersonajesDeStarWars ..> PersonajesDeLaGuerraDeLosClones : la era de los clones
PersonajesDeStarWars ..> Figuras
PersonajesDeLaGuerraDeLosClones ..> Figuras
Personaje *-- "1..*" Capa
legend right
  Color sin prefijo = java.awt.Color (cómo se pinta).
  modelo.Color = el color de las piezas (BLANCO / NEGRO).
  Todo lo que tiene comportamiento intercambiable (el juego, los temas,
  las dificultades) lo crea Principal (d7_composicion).
  PanelDelTablero acomoda las casillas a mano: el lado más grande que
  entra a lo ancho y a lo alto. Siempre cuadradas y centradas.
endlegend
note top of PanelDelMenu
  Las pantallas las crea VentanaSwing, y el tablero, PanelDeLaPartida.
  Ninguno conoce a quien lo creó: avisan lo que se eligió o se
  clickeó con callbacks (Runnable, Consumer, BiConsumer)
  que reciben por constructor.
end note
note bottom of PersonajesDeStarWars
  Dos eras, un elenco cada una (decisión 37):
  Rebelión (blancas): Luke, Leia, Yoda, Chewbacca, R2-D2, piloto.
  Imperio (negras): Palpatine, Vader, Guardia Imperial, Boba Fett,
  Estrella de la Muerte, stormtrooper.
  República (blancas): Yoda, Anakin, Obi-Wan, Ahsoka, AT-TE, clon.
  Separatistas (negras): Dooku, Grievous, Ventress, droideka,
  súper droide, droide de combate. Todos dibujados con figuras.
  El fondo de la Rebelión es un póster (gui/fondo-star-wars.jpg):
  lo lee Principal; sin póster, TemaStarWars dibuja el espacio.
end note
@enduml
