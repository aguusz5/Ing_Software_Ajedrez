@startuml d2_modelo
!include common.iuml
top to bottom direction
package "ajedrez-nucleo :: modelo" #EAF6EA {
  class Posicion <<record>> {
    +columna : int
    +fila : int
    +desplazar(d : Direccion) : Posicion
  }
  class Direccion <<record>> {
    +dx : int
    +dy : int
    +{static} ORTOGONALES : List<Direccion>
    +{static} DIAGONALES : List<Direccion>
    +{static} TODAS : List<Direccion>
    +{static} SALTOS_DE_CABALLO : List<Direccion>
  }
  enum Color {
    BLANCO
    NEGRO
    +contrario() : Color
    +sentidoDeAvance() : int
  }
  class Tablero <<inmutable>> {
    +Tablero(ancho : int, alto : int)
    +ancho() : int
    +alto() : int
    +estaDentro(p : Posicion) : boolean
    +piezaEn(p : Posicion) : Optional<Pieza>
    +buscarRey(c : Color) : Posicion
    +puntosDe(c : Color) : int
    +potenciadorEn(p : Posicion) : Optional<Potenciador>
    +cantidadDePotenciadores() : int
    +con(p : Posicion, pieza : Pieza) : Tablero
    +sin(p : Posicion) : Tablero
    +conPotenciador(p : Posicion, pot : Potenciador) : Tablero
    +sinPotenciadoresDe(c : Color) : Tablero
  }
  class Pieza <<record>> {
    +color : Color
    +tipo : TipoDePieza
    +yaSeMovio : boolean
    +potenciador : Optional<Potenciador>
    +Pieza(color : Color, tipo : TipoDePieza)
    +Pieza(color : Color, tipo : TipoDePieza, yaSeMovio : boolean)
    +movida() : Pieza
    +conPotenciador(pot : Potenciador) : Pieza
    +sinPotenciador() : Pieza
    +jugadasCandidatas(t : Tablero, desde : Posicion) : List<Jugada>
  }
  class Potenciador {
    +Potenciador(nombre : String, descripcion : String, regla : ReglaDeMovimiento)
    +nombre() : String
    +descripcion() : String
    ~regla() : ReglaDeMovimiento
  }
  class TipoDePieza {
    +TipoDePieza(nombre : String, esRey : boolean, valor : int, reglas : List<ReglaDeMovimiento>)
    +nombre() : String
    +esRey() : boolean
    +valor() : int
    ~reglas() : List<ReglaDeMovimiento>
  }
}
package "ajedrez-nucleo :: movimiento" #EAF6EA {
  interface ReglaDeMovimiento <<Strategy>> {
    +jugadasCandidatas(t : Tablero, desde : Posicion, p : Pieza) : List<Jugada>
    +adaptarJugadaPrestada(t : Tablero, prestada : Jugada, p : Pieza) : List<Jugada> {default: la deja igual; el avance del peón corona}
  }
  class ReglaAvanceDePeon {
    +ReglaAvanceDePeon(coronaciones : List<TipoDePieza>)
  }
  class ReglaCapturaDePeon {
    +ReglaCapturaDePeon(coronaciones : List<TipoDePieza>)
  }
  class ReglaDeEnroque {
    +ReglaDeEnroque(companera : TipoDePieza)
  }
  class ReglaDeslizante {
    +{static} SIN_LIMITE : int
    +ReglaDeslizante(direcciones : List<Direccion>, pasosMaximos : int)
  }
  class ReglaDeSalto {
    +ReglaDeSalto(saltos : List<Direccion>)
  }
  interface Jugada {
    +desde() : Posicion
    +hasta() : Posicion
    +aplicarEn(t : Tablero) : Tablero
    +promocion() : Optional<TipoDePieza>
    +casillasQueNoPuedenEstarAtacadas() : List<Posicion>
  }
  class JugadaSimple <<record>> {
    +desde : Posicion
    +hasta : Posicion
  }
  class JugadaConPromocion <<record>> {
    +desde : Posicion
    +hasta : Posicion
    +nuevoTipo : TipoDePieza
  }
  class JugadaDeEnroque <<record>> {
    +desde : Posicion
    +hasta : Posicion
    +desdeTorre : Posicion
    +hastaTorre : Posicion
  }
}
package "ajedrez-nucleo :: configuracion" #EAF6EA {
  class TiposDePiezaEstandar <<catálogo estático>> {
    +{static} peon() / torre() / caballo()
    +{static} alfil() / dama() / rey()
  }
  class TableroEstandar {
    +crearTablero() : Tablero
  }
  class PotenciadoresStarWars <<catálogo estático>> {
    +{static} hiperespacio() / fuerza()
    +{static} propulsores() / sableDeLuz()
    +{static} todos() : List<Potenciador>
  }
}
' Cada relación se escribe con la clase de arriba primero: no cambia la flecha,
' solo le dice a Graphviz qué va arriba (modelo) y qué va abajo (movimiento).
TableroEstandar ..> TiposDePiezaEstandar
TableroEstandar ..> Tablero : crea
TiposDePiezaEstandar ..> TipoDePieza : crea
Tablero o-- "0..*" Pieza : una por Posicion
Tablero o-- "0..*" Potenciador : esperando en casillas vacías
Pieza --> "0..1" Potenciador : tomó (dura un turno)
Potenciador --> "1" ReglaDeMovimiento : movimiento extra
PotenciadoresStarWars ..> Potenciador : crea
Pieza --> Color
Pieza --> TipoDePieza
Posicion ..> Direccion
TipoDePieza o-- "1..*" ReglaDeMovimiento
Pieza ..> Jugada : jugadasCandidatas()
ReglaDeMovimiento ...> Jugada : crea
ReglaDeMovimiento <|.. ReglaAvanceDePeon
ReglaDeMovimiento <|.. ReglaCapturaDePeon
ReglaDeMovimiento <|.. ReglaDeEnroque
ReglaDeMovimiento <|.. ReglaDeslizante
ReglaDeMovimiento <|.. ReglaDeSalto
TipoDePieza "1..*" <-- ReglaAvanceDePeon : coronaciones
TipoDePieza "1..*" <-- ReglaCapturaDePeon : coronaciones
TipoDePieza <-- ReglaDeEnroque : compañera
Direccion "1..*" <-- ReglaDeslizante
Direccion "1..*" <-- ReglaDeSalto
Jugada <|.. JugadaSimple
Jugada <|.. JugadaConPromocion
Jugada <|.. JugadaDeEnroque
TipoDePieza <-- JugadaConPromocion : nuevoTipo
note bottom of Tablero
  Sin interfaz de solo lectura: Tablero es inmutable,
  nadie puede modificarlo aunque lo reciba.
end note
@enduml
