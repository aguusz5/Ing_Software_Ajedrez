@startuml d4_adaptadores
!include common.iuml
top to bottom direction
package "ajedrez-nucleo :: juego (el puerto y quien lo implementa)" #EAF6EA {
  interface JuegoDeAjedrez <<puerto de entrada>>
  class Partida
}
package "ajedrez-nucleo :: ia" #EAF6EA {
  class Computadora
  class ContraLaComputadora
}
package "ajedrez-consola (adaptador)" #E8F1FA {
  class AdaptadorConsola {
    +AdaptadorConsola(juego, traductor, dibujante, entrada : Scanner, salida : PrintStream, rival : Optional<ContraLaComputadora>)
    +ejecutar()
  }
  class TraductorDeNotacion {
    +leer(texto : String, t : Tablero) : Posicion
    +escribir(p : Posicion) : String
  }
  class DibujanteAscii {
    +dibujar(t : Tablero) : String
  }
}
package "ajedrez-gui-swing (adaptador)" #E8F1FA {
  class VentanaSwing {
    +VentanaSwing(juego : JuegoDeAjedrez, temas : List<Tema>, dificultades : List<Dificultad>)
    +mostrar()
  }
  class Dificultad <<record>> {
    +nombre : String
    +descripcion : String
    +siElegisBlancas : ContraLaComputadora
    +siElegisNegras : ContraLaComputadora
    +paraJugarCon(colorDelJugador : modelo.Color) : ContraLaComputadora
  }
  class PanelDelMenu <<pantalla>> {
    ~usarTema(t : Tema)
    ~permitirVolverALaPartida()
  }
  class PanelDeLaPartida <<pantalla>> {
    ~usarTema(t : Tema)
    ~empezarUnoContraUno()
    ~empezarContraLaComputadora(rival : ContraLaComputadora)
  }
  class PanelDelTablero {
    ~setInvertido(invertido : boolean)
    ~usarColores(coordenadas : Color, marco : Color)
    ~mostrar(p : Posicion, pieza : Optional<DibujoDePieza>, fondo : Color, borde : Border)
    ~{static} coordenada(p : Posicion) : String
  }
  interface Tema <<Strategy>> {
    +nombre() : String
    +epigrafe() : String
    +paleta() : Paleta
    +bando(c : modelo.Color) : String
    +nombreDe(tipo : String, c : modelo.Color) : String
    +dibujoDe(p : Pieza) : DibujoDePieza
    +pintarFondo(g : Graphics2D, ancho : int, alto : int)
  }
  class TemaClasico {
    +TemaClasico(glifos : GlifosDePieza)
  }
  class TemaStarWars {
    +TemaStarWars(glifos : GlifosDePieza, personajes : PersonajesDeStarWars, imagenDeFondo : Optional<BufferedImage>)
  }
  class Paleta <<record>> {
    +casillaClara, casillaOscura : Color
    +texto, titulo, epigrafe, marco : Color
    +fondoDelMenu : Color
  }
  interface DibujoDePieza {
    +nombre() : String
    +dibujar(g : Graphics, ancho : int, alto : int)
  }
  class DibujoDeGlifo <<record>> {
    +nombre : String
    +glifo : String
    +relleno, trazo : Color
  }
  class DibujoDePersonaje <<record>> {
    +nombre : String
    +brillo : Color
  }
  class PersonajesDeStarWars {
    ~personajeDe(tipo : String, bando : modelo.Color) : Optional<Personaje>
  }
  class Personaje {
    ~{static} LADO : double
    ~Personaje(nombre : String, capas : List<Capa>)
    ~nombre() : String
    ~dibujar(g : Graphics2D, brillo : Color)
  }
  class "Personaje.Capa" as Capa <<record>> {
    +forma : Shape
    +pintura : Paint
  }
  class GlifosDePieza {
    +glifoDe(p : Pieza) : String
  }
}
package "ajedrez-app (raíz de composición)" #FFF4E0 {
  class Principal {
    +{static} main(args : String[])
  }
}
Partida ..|> JuegoDeAjedrez
AdaptadorConsola --> JuegoDeAjedrez
AdaptadorConsola --> TraductorDeNotacion
AdaptadorConsola --> DibujanteAscii
VentanaSwing *-- PanelDelMenu
VentanaSwing *-- PanelDeLaPartida
PanelDelMenu --> "*" Dificultad : las ofrece
PanelDeLaPartida --> JuegoDeAjedrez
PanelDeLaPartida --> Tema : el elegido en el menú
PanelDelMenu --> "*" Tema : los ofrece
PanelDeLaPartida --> "0..1" ContraLaComputadora : la del modo elegido
PanelDeLaPartida *-- PanelDelTablero
PanelDelTablero ..> DibujoDePieza
TemaClasico ..|> Tema
TemaStarWars ..|> Tema
Tema ..> Paleta
Tema ..> DibujoDePieza : crea
DibujoDeGlifo ..|> DibujoDePieza
DibujoDePersonaje ..|> DibujoDePieza
DibujoDePersonaje --> Personaje
DibujoDePersonaje --> DibujoDeGlifo : insignia
TemaClasico --> GlifosDePieza
TemaStarWars --> GlifosDePieza
TemaStarWars --> PersonajesDeStarWars
PersonajesDeStarWars --> "12" Personaje
Personaje *-- "1..*" Capa
Dificultad --> "2" ContraLaComputadora : una por color
ContraLaComputadora --> Computadora
AdaptadorConsola --> "0..1" ContraLaComputadora
Principal ..> Partida : new + inyecta
Principal ..> Computadora : new (una por dificultad)
Principal ..> ContraLaComputadora : new (dos por dificultad)
Principal ..> Dificultad : new
Principal ..> AdaptadorConsola : new + inyecta
Principal ..> TraductorDeNotacion : new
Principal ..> DibujanteAscii : new
Principal ..> VentanaSwing : new + inyecta
Principal ..> TemaStarWars : new + le pasa el póster
Principal ..> TemaClasico : new
Principal ..> GlifosDePieza : new
Principal ..> PersonajesDeStarWars : new
legend right
  Color sin prefijo = java.awt.Color (cómo se pinta).
  modelo.Color = el color de las piezas (BLANCO / NEGRO).
endlegend
note bottom of PanelDelTablero
  Acomoda las casillas a mano: el lado más grande que entra
  a lo ancho y a lo alto. Siempre cuadradas y centradas.
end note
note top of PanelDelMenu
  Las pantallas las crea VentanaSwing, y el tablero, PanelDeLaPartida.
  Ninguno conoce a quien lo creó: avisan lo que se eligió o se
  clickeó con callbacks (Runnable, Consumer, BiConsumer)
  que reciben por constructor.
end note
note bottom of PersonajesDeStarWars
  Rebelión (blancas): Luke, Leia, Yoda, Chewbacca, R2-D2, piloto.
  Imperio (negras): Palpatine, Vader, Guardia Imperial, Boba Fett,
  Estrella de la Muerte, stormtrooper. Dibujados con figuras.
  El fondo es un póster (gui/fondo-star-wars.jpg, en los recursos):
  lo lee Principal; si no está, TemaStarWars dibuja el espacio.
end note
@enduml
